{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe.schema.json",
  "title": "Recipe frontmatter",
  "type": "object",
  "required": ["title", "category", "servings", "source", "status", "gluten_check", "created", "updated"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": { "type": "string", "description": "Slug from schema/categories.yml" },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "servings": { "type": "number", "exclusiveMinimum": 0 },
    "servings_unit": { "type": "string" },
    "prep_time": { "type": "integer", "minimum": 0, "description": "minutes" },
    "cook_time": { "type": "integer", "minimum": 0, "description": "minutes" },
    "rest_time": { "type": "integer", "minimum": 0, "description": "minutes" },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "diet": {
      "type": "array",
      "items": { "enum": ["vegetarian", "vegan", "lactose-free", "egg-free", "nut-free"] },
      "uniqueItems": true
    },
    "source": { "enum": ["own", "ai", "web", "book", "family"] },
    "source_detail": { "type": "string", "description": "URL, book title, person ..." },
    "ai_model": { "type": "string" },
    "status": { "enum": ["untested", "tested", "favorite"] },
    "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
    "gluten_check": { "enum": ["pending", "passed"] },
    "image": { "type": "string", "description": "Filename in cookbook/images/" },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "cssclasses": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "source": { "const": "ai" } } },
      "then": { "required": ["ai_model"] }
    }
  ]
}
